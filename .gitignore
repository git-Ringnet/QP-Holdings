# Repo chứa đủ để clone về là chạy được trên máy dev (XAMPP):
#   lõi WordPress, plugin, theme, wp-config.php + .htaccess bản DEV, database đã làm sạch.
# KHÔNG chứa: ảnh uploads (~5,5 GB — .htaccess dev tự lấy ảnh từ qpholdings.vn), cache, log, backup,
#   wp-config-local.php (cấu hình riêng từng máy).
# Cách làm: bỏ qua tất cả, rồi "mở" (!) từng đường dẫn cần theo dõi.

/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/LICENSE
!/docs/
!/tools/
!/bin/
!/database/
!/.claude/
!/.gemini/

# Lõi WordPress + cấu hình dev
!/wp-admin/
!/wp-includes/
!/index.php
!/wp-*.php
!/xmlrpc.php
!/license.txt
!/readme.html
!/favicon.ico
!/.htaccess
# Cấu hình riêng từng máy (khớp mẫu wp-*.php ở trên nên phải chặn lại)
/wp-config-local.php

!/wp-content/
/wp-content/*
!/wp-content/index.php
!/wp-content/themes/
!/wp-content/plugins/
!/wp-content/mu-plugins/
!/wp-content/languages/

/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/qp-holdings/

# Plugin: lấy tất cả, trừ bản trả phí không dùng và thư mục tắt cũ
/wp-content/plugins/duplicator-pro/
/wp-content/plugins/polylang_off/

# Rác
.deploy-backups/
.seo-deploy-backup-*/
*.tmp-*
*.bak
*.log
.DS_Store
Thumbs.db
node_modules/

# Gói deploy sinh ra bởi tools/make-deploy-zip.ps1
/dist/
# WP-CLI tải về bởi tools/restore-plesk-backup.ps1
/tools/.cache/

# Cấu hình cá nhân của Claude Code
/.claude/settings.local.json
