 cannot rename this folder.":{"is_plural":false,"context":null,"singular":"The given folder does not exist or you cannot rename this folder.","plural":null,"translations":["\u7ed9\u5b9a\u7684\u6587\u4ef6\u5939\u4e0d\u5b58\u5728\u6216\u65e0\u6cd5\u91cd\u547d\u540d\u6b64\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"The given folder does not exist.":{"is_plural":false,"context":null,"singular":"The given folder does not exist.","plural":null,"translations":["\u7ed9\u5b9a\u7684\u6587\u4ef6\u5939\u4e0d\u5b58\u5728\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"The given folder was not found.":{"is_plural":false,"context":null,"singular":"The given folder was not found.","plural":null,"translations":["\u6ca1\u6709\u627e\u5230\u7ed9\u5b9a\u7684\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"The given parent does not allow the folder type.":{"is_plural":false,"context":null,"singular":"The given parent does not allow the folder type.","plural":null,"translations":["\u7ed9\u5b9a\u7684\u7236\u7c7b\u4e0d\u5141\u8bb8\u6587\u4ef6\u5939\u7c7b\u578b\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"The given parent does not exist to set the parent for this folder.":{"is_plural":false,"context":null,"singular":"The given parent does not exist to set the parent for this folder.","plural":null,"translations":["\u4e0d\u5b58\u5728\u7ed9\u5b9a\u7684\u7236\u6587\u4ef6\u5939\u6765\u8bbe\u7f6e\u6b64\u6587\u4ef6\u5939\u7684\u7236\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"The parent %d does not exist.":{"is_plural":false,"context":null,"singular":"The parent %d does not exist.","plural":null,"translations":["\u7236 %d \u4e0d\u5b58\u5728\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"This file has no associated shortcuts. You can create shortcuts by moving files per mouse and hold any key.":{"is_plural":false,"context":null,"singular":"This file has no associated shortcuts. You can create shortcuts by moving files per mouse and hold any key.","plural":null,"translations":["\u6b64\u6587\u4ef6\u6ca1\u6709\u76f8\u5173\u7684\u5feb\u6377\u65b9\u5f0f\u3002\u60a8\u53ef\u4ee5\u521b\u5efa\u5feb\u6377\u65b9\u5f0f\u79fb\u52a8\u6587\u4ef6\u6bcf\u9f20\u6807\u548c\u4e3e\u884c\u4efb\u4f55\u5173\u952e\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"This folder has an automatic order. Please deactivate that first.":{"is_plural":false,"context":null,"singular":"This folder has an automatic order. Please deactivate that first.","plural":null,"translations":["\u6b64\u6587\u4ef6\u5939\u6709\u81ea\u52a8\u8ba2\u5355\uff0c\u8bf7\u5148\u505c\u7528\u5b83\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"This functionality is not available in the free version (%s).":{"is_plural":false,"context":null,"singular":"This functionality is not available in the free version (%s).","plural":null,"translations":["\u514d\u8d39\u7248\u672c\uff08%s\uff09\u4e2d\u4e0d\u63d0\u4f9b\u6b64\u529f\u80fd\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"This is a shortcut of a media library file. Shortcuts doesn't need any physical storage <strong>(0 kB)<\/strong>. If you want to change the file itself, you must do this in the original file (for example replace media file through a plugin).<br\/>Note also that the fields in the shortcuts can be different to the original file, for example \"Title\", \"Description\" or \"Caption\".":{"is_plural":false,"context":null,"singular":"This is a shortcut of a media library file. Shortcuts doesn't need any physical storage <strong>(0 kB)<\/strong>. If you want to change the file itself, you must do this in the original file (for example replace media file through a plugin).<br\/>Note also that the fields in the shortcuts can be different to the original file, for example \"Title\", \"Description\" or \"Caption\".","plural":null,"translations":["\u8fd9\u662f\u5a92\u4f53\u5e93\u6587\u4ef6\u7684\u5feb\u6377\u65b9\u5f0f\u3002\u5feb\u6377\u952e\u4e0d\u9700\u8981\u4efb\u4f55\u7269\u7406\u5b58\u50a8<strong>(0kb)<\/strong>\u3002\u5982\u679c\u60a8\u60f3\u8981\u66f4\u6539\u6587\u4ef6\u672c\u8eab\uff0c\u60a8\u5fc5\u987b\u5728\u539f\u59cb\u6587\u4ef6\u4e2d\u8fd9\u6837\u505a(\u4f8b\u5982\uff0c\u901a\u8fc7\u63d2\u4ef6\u66ff\u6362\u5a92\u4f53\u6587\u4ef6)\u3002<br\/>\u8fd8\u5e94\u6ce8\u610f\uff0c\u5feb\u6377\u952e\u4e2d\u7684\u5b57\u6bb5\u53ef\u80fd\u4e0e\u539f\u59cb\u6587\u4ef6\u4e0d\u540c\uff0c\u4f8b\u5982\u201c\u6807\u9898\u201d\u3001\u201c\u63cf\u8ff0\u201d\u6216\u201c\u6807\u9898\u201d\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Unorganized":{"is_plural":false,"context":null,"singular":"Unorganized","plural":null,"translations":["\u65e0\u7ec4\u7ec7\u7684"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Unorganized is the same as a root folder. Here you can find all files which are not assigned to a folder.":{"is_plural":false,"context":null,"singular":"Unorganized is the same as a root folder. Here you can find all files which are not assigned to a folder.","plural":null,"translations":["\u65e0\u7ec4\u7ec7\u7684\u4e0e\u6839\u6587\u4ef6\u5939\u76f8\u540c\u3002\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u627e\u5230\u6240\u6709\u6ca1\u6709\u5206\u914d\u7ed9\u6587\u4ef6\u5939\u7684\u6587\u4ef6\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Unorganized pictures":{"is_plural":false,"context":null,"singular":"Unorganized pictures","plural":null,"translations":["\u65e0\u7ec4\u7ec7\u7684\u56fe\u7247"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"WPML: Automatically move translations":{"is_plural":false,"context":null,"singular":"WPML: Automatically move translations","plural":null,"translations":["WPML:\u81ea\u52a8\u79fb\u52a8\u7ffb\u8bd1"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Wipe all":{"is_plural":false,"context":null,"singular":"Wipe all","plural":null,"translations":["\u64e6\u62ed\u6240\u6709"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Wipe all settings (folders, attachment relations)":{"is_plural":false,"context":null,"singular":"Wipe all settings (folders, attachment relations)","plural":null,"translations":["\u6e05\u9664\u6240\u6709\u8bbe\u7f6e(\u6587\u4ef6\u5939\u3001\u9644\u4ef6\u5173\u7cfb)"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"Wipe attachment relations":{"is_plural":false,"context":null,"singular":"Wipe attachment relations","plural":null,"translations":["\u64e6\u4f9d\u604b\u5173\u7cfb"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to change the parent for this folder.":{"is_plural":false,"context":null,"singular":"You are not allowed to change the parent for this folder.","plural":null,"translations":["\u4e0d\u5141\u8bb8\u66f4\u6539\u6b64\u6587\u4ef6\u5939\u7684\u7236\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to create a subfolder here.":{"is_plural":false,"context":null,"singular":"You are not allowed to create a subfolder here.","plural":null,"translations":["\u60a8\u4e0d\u5141\u8bb8\u5728\u8fd9\u91cc\u521b\u5efa\u5b50\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to delete this folder.":{"is_plural":false,"context":null,"singular":"You are not allowed to delete this folder.","plural":null,"translations":["\u4e0d\u5141\u8bb8\u60a8\u5220\u9664\u6b64\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to insert files here.":{"is_plural":false,"context":null,"singular":"You are not allowed to insert files here.","plural":null,"translations":["\u4e0d\u5141\u8bb8\u5728\u8fd9\u91cc\u63d2\u5165\u6587\u4ef6\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to move the file.":{"is_plural":false,"context":null,"singular":"You are not allowed to move the file.","plural":null,"translations":["\u4e0d\u5141\u8bb8\u60a8\u79fb\u52a8\u6587\u4ef6\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You are not allowed to rename this folder.":{"is_plural":false,"context":null,"singular":"You are not allowed to rename this folder.","plural":null,"translations":["\u4e0d\u5141\u8bb8\u91cd\u547d\u540d\u6b64\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You can also reset an single folder in its folder details.":{"is_plural":false,"context":null,"singular":"You can also reset an single folder in its folder details.","plural":null,"translations":["\u60a8\u8fd8\u53ef\u4ee5\u5728\u5bfc\u822a\u5230\u6587\u4ef6\u5939\u8be6\u7ec6\u4fe1\u606f\u65f6\u91cd\u7f6e\u5355\u4e2a\u6587\u4ef6\u5939\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You can only move images to a gallery.":{"is_plural":false,"context":null,"singular":"You can only move images to a gallery.","plural":null,"translations":["\u60a8\u53ea\u80fd\u5c06\u56fe\u50cf\u79fb\u52a8\u5230\u56fe\u5e93\u3002"],"translator_comments":"","extracted_comments":"","references":[],"flags":[]},"You can simply upload files directly to a folder. Select a folder and upload files.":{"is_plural":false,"context":null,"singular":"You can simply upload files directly to a folder. Select a folder and upload files.","plural":null,"translations":["\u4f60\u53ef\u4ee5\u76f4\u63a5\u5c06\u6587\u4ef6\u4e0a\u4f20\u5230\u4e00\u4e2a\u6587\u4ef6\